{
  "info": {
    "_postman_id": "b0u1eva7-d000-4000-a000-b0u1evard0001",
    "name": "Boulevard API",
    "description": "GraphQL Admin API, GraphQL Client API, and REST Tokenization API for Boulevard - a client experience platform for appointment-based self-care businesses. Requires an Enterprise-tier Boulevard account, a sandbox businessId, and an apiKey provisioned through the Boulevard Developer Portal (developers.joinblvd.com).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{apiKey}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "adminApiUrl", "value": "https://dashboard.boulevard.io/api/2020-01/admin" },
    { "key": "clientApiUrl", "value": "https://dashboard.boulevard.io/api/2020-01/client" },
    { "key": "tokenizeUrl", "value": "https://vault.blvd.co/cards/tokenize" },
    { "key": "businessId", "value": "urn:blvd:Business:00000000-0000-0000-0000-000000000000" },
    { "key": "apiKey", "value": "" }
  ],
  "item": [
    {
      "name": "Admin API - Clients & CRM",
      "item": [
        {
          "name": "Get client by ID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Boulevard-Business-Id", "value": "{{businessId}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetClient($id: ID!) {\n  client(id: $id) {\n    id\n    firstName\n    lastName\n    email\n    phone\n    loyaltyPointsBalance\n    customFields { key value }\n  }\n}",
                "variables": "{\n  \"id\": \"{{clientId}}\"\n}"
              }
            },
            "url": { "raw": "{{adminApiUrl}}", "host": ["{{adminApiUrl}}"] }
          },
          "response": []
        },
        {
          "name": "List clients updated since",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Boulevard-Business-Id", "value": "{{businessId}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ListClients($updatedSince: DateTime, $first: Int) {\n  clients(updatedSince: $updatedSince, first: $first) {\n    id\n    firstName\n    lastName\n    email\n    updatedAt\n  }\n}",
                "variables": "{\n  \"updatedSince\": \"2026-06-01T00:00:00Z\",\n  \"first\": 50\n}"
              }
            },
            "url": { "raw": "{{adminApiUrl}}", "host": ["{{adminApiUrl}}"] }
          },
          "response": []
        },
        {
          "name": "updateClient mutation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Boulevard-Business-Id", "value": "{{businessId}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateClient($input: UpdateClientInput!) {\n  updateClient(input: $input) {\n    id\n    customFields { key value }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"clientId\": \"{{clientId}}\",\n    \"customFields\": [ { \"key\": \"loyalty_points\", \"value\": 250 } ]\n  }\n}"
              }
            },
            "url": { "raw": "{{adminApiUrl}}", "host": ["{{adminApiUrl}}"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin API - Appointments, Staff & Locations",
      "item": [
        {
          "name": "List appointments for a location",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Boulevard-Business-Id", "value": "{{businessId}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ListAppointments($locationId: ID, $status: AppointmentStatus, $since: DateTime) {\n  appointments(locationId: $locationId, status: $status, since: $since) {\n    id\n    status\n    startAt\n    endAt\n    client { id firstName lastName }\n    staff { id displayName }\n  }\n}",
                "variables": "{\n  \"locationId\": \"{{locationId}}\",\n  \"status\": \"CONFIRMED\",\n  \"since\": \"2026-07-01T00:00:00Z\"\n}"
              }
            },
            "url": { "raw": "{{adminApiUrl}}", "host": ["{{adminApiUrl}}"] }
          },
          "response": []
        },
        {
          "name": "List locations and staff",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Boulevard-Business-Id", "value": "{{businessId}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ListLocations {\n  locations {\n    id\n    name\n    timezone\n    staff { id displayName bookable }\n  }\n}",
                "variables": "{}"
              }
            },
            "url": { "raw": "{{adminApiUrl}}", "host": ["{{adminApiUrl}}"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin API - Memberships & Packages",
      "item": [
        {
          "name": "List active memberships for a client",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Boulevard-Business-Id", "value": "{{businessId}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ListMemberships($clientId: ID, $status: MembershipStatus) {\n  memberships(clientId: $clientId, status: $status) {\n    id\n    planName\n    status\n    renewsAt\n    entitlements { service { name } remainingUses }\n  }\n}",
                "variables": "{\n  \"clientId\": \"{{clientId}}\",\n  \"status\": \"ACTIVE\"\n}"
              }
            },
            "url": { "raw": "{{adminApiUrl}}", "host": ["{{adminApiUrl}}"] }
          },
          "response": []
        }
      ]
    },
    {
