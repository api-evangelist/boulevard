                "query": "mutation AdjustAccountCredit($input: CreateAccountCreditAdjustmentInput!) {\n  createAccountCreditAdjustment(input: $input) {\n    id\n    resultingBalance\n    adjustmentReason\n  }\n}",
                "variables": "{\n  \"input\": { \"clientId\": \"{{clientId}}\", \"locationId\": \"{{locationId}}\", \"adjustmentReason\": \"REFERRAL_REWARD\", \"balanceDelta\": 10.00 }\n}"
              }
            },
            "url": { "raw": "{{adminApiUrl}}", "host": ["{{adminApiUrl}}"] }
          },
          "response": []
        },
        {
          "name": "vouchersCreate mutation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Boulevard-Business-Id", "value": "{{businessId}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateVouchers($input: VouchersCreateInput!) {\n  vouchersCreate(input: $input) {\n    id\n    status\n    expiresAt\n  }\n}",
                "variables": "{\n  \"input\": { \"clientId\": \"{{clientId}}\", \"locationId\": \"{{locationId}}\", \"serviceIds\": [\"{{serviceId}}\"], \"quantity\": 1 }\n}"
              }
            },
            "url": { "raw": "{{adminApiUrl}}", "host": ["{{adminApiUrl}}"] }
          },
          "response": []
        }
      ]
    },
