    {
      "name": "Tokenization API",
      "item": [
        {
          "name": "Tokenize a card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"4242424242424242\",\n  \"expMonth\": 12,\n  \"expYear\": 2028,\n  \"cvc\": \"123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{tokenizeUrl}}", "host": ["{{tokenizeUrl}}"] }
          },
          "response": [
            {
              "name": "OK",
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{tokenizeUrl}}", "host": ["{{tokenizeUrl}}"] }
              },
              "status": "OK",
              "code": 200,
              "header": [ { "key": "Content-Type", "value": "application/json" } ],
              "body": "{\n  \"token\": \"tok_1a2b3c4d5e6f\",\n  \"last4\": \"4242\",\n  \"brand\": \"visa\"\n}",
